{
  "version": "1.0",
  "formats": {
    "signal_selection": {
      "type": "object",
      "properties": {
        "domain": {"type": "string"},
        "scenes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "signals": {"type": "array", "items": {"type": "string"}},
        "missing_concepts": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"}
      },
      "required": ["domain", "scenes", "signals", "missing_concepts", "reason"],
      "additionalProperties": false
    },
    "global_semantics": {
      "type": "object",
      "properties": {
        "revision": {"type": "integer", "minimum": 0},
        "summary": {"type": "string"},
        "is_clear": {"type": "boolean"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "nl_fragment": {"type": "string"},
              "kind": {"enum": ["scope", "signal", "predicate", "temporal", "trigger", "logic", "unit", "other"]},
              "value": {"type": "string"},
              "stl_fragment": {"type": "string"},
              "status": {"enum": ["resolved", "pending"]},
              "source": {"enum": ["original_nl", "user", "knowledge_base", "search", "llm_inference"]}
            },
            "required": ["id", "nl_fragment", "kind", "value", "stl_fragment", "status", "source"],
            "additionalProperties": false
          }
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "nl_fragment": {"type": "string"},
              "category": {"enum": ["signal", "threshold", "unit", "time", "scope", "trigger", "operator", "other"]},
              "description": {"type": "string"},
              "question": {"type": "string"}
            },
            "required": ["id", "nl_fragment", "category", "description", "question"],
            "additionalProperties": false
          }
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nl_fragment": {"type": "string"},
              "stl_fragment": {"type": "string"},
              "status": {"enum": ["resolved", "pending"]}
            },
            "required": ["nl_fragment", "stl_fragment", "status"],
            "additionalProperties": false
          }
        }
      },
      "required": ["revision", "summary", "is_clear", "items", "ambiguities", "mappings"],
      "additionalProperties": false
    },
    "semantic_revision": {
      "type": "object",
      "properties": {
        "applicable": {"type": "boolean"},
        "revised_semantics": {"$ref": "#/$defs/global_semantics"},
        "change_summary": {"type": "string"},
        "reason": {"type": "string"},
        "needs_follow_up": {"type": "boolean"},
        "follow_up_question": {"type": ["string", "null"]}
      },
      "required": ["applicable", "revised_semantics", "change_summary", "reason", "needs_follow_up", "follow_up_question"],
      "additionalProperties": false,
      "$defs": {
        "global_semantics": {
          "type": "object",
          "properties": {
            "revision": {"type": "integer", "minimum": 0},
            "summary": {"type": "string"},
            "is_clear": {"type": "boolean"},
            "items": {"type": "array", "items": {"type": "object"}},
            "ambiguities": {"type": "array", "items": {"type": "object"}},
            "mappings": {"type": "array", "items": {"type": "object"}}
          },
          "required": ["revision", "summary", "is_clear", "items", "ambiguities", "mappings"],
          "additionalProperties": false
        }
      }
    },
    "semantic_revision_review": {
      "type": "object",
      "properties": {
        "valid": {"type": "boolean"},
        "reason": {"type": "string"},
        "follow_up_question": {"type": ["string", "null"]}
      },
      "required": ["valid", "reason", "follow_up_question"],
      "additionalProperties": false
    },
    "candidate_set": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "value": {"type": "string", "maxLength": 160},
              "explanation": {"type": "string", "maxLength": 120},
              "source_type": {"enum": ["knowledge_base", "search", "llm_generated"]},
              "source_reference": {"type": "string", "maxLength": 240},
              "canonical": {"type": "string"}
            },
            "required": ["id", "value", "explanation", "source_type", "source_reference", "canonical"],
            "additionalProperties": false
          }
        },
        "insufficient_reason": {"type": "string"}
      },
      "required": ["candidates", "insufficient_reason"],
      "additionalProperties": false
    },
    "search_query": {
      "type": "object",
      "properties": {"query": {"type": "string"}},
      "required": ["query"],
      "additionalProperties": false
    },
    "candidate_review": {
      "type": "object",
      "properties": {
        "accepted_ids": {"type": "array", "items": {"type": "string"}},
        "rejections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"id": {"type": "string"}, "reason": {"type": "string"}},
            "required": ["id", "reason"],
            "additionalProperties": false
          }
        }
      },
      "required": ["accepted_ids", "rejections"],
      "additionalProperties": false
    },
    "semantic_review": {
      "type": "object",
      "properties": {
        "valid": {"type": "boolean"},
        "errors": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"}
      },
      "required": ["valid", "errors", "reason"],
      "additionalProperties": false
    },
    "search_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "url": {"type": "string"},
          "content": {"type": "string"}
        },
        "required": ["title", "url", "content"],
        "additionalProperties": false
      }
    },
    "graph_state": {
      "type": "object",
      "properties": {
        "session_id": {"type": "string"},
        "original_text": {"type": "string"},
        "phase": {"type": "string"},
        "signal_selection": {"type": "object"},
        "signal_details": {"type": "object"},
        "global_semantics": {"type": "object"},
        "semantic_history": {"type": "array"},
        "current_ambiguity": {"type": "object"},
        "candidates": {"type": "array"},
        "search_results": {"type": "array"},
        "ast": {"type": "object"},
        "stl": {"type": "string"},
        "validation_errors": {"type": "array"},
        "ast_repairs": {"type": "integer", "minimum": 0},
        "status": {"enum": ["running", "complete", "error"]}
      },
      "required": ["session_id", "original_text", "phase", "semantic_history", "ast_repairs", "status"],
      "additionalProperties": true
    },
    "final_result": {
      "type": "object",
      "properties": {
        "original_text": {"type": "string"},
        "global_semantics": {"type": "object"},
        "mappings": {"type": "array"},
        "ast": {"type": "object"},
        "ast_path": {"type": "string"},
        "stl": {"type": "string"},
        "stl_semantics": {"type": "string"},
        "schema_validation": {"type": "string"},
        "elapsed_seconds": {"type": "number", "minimum": 0}
      },
      "required": ["original_text", "global_semantics", "mappings", "ast", "ast_path", "stl", "stl_semantics", "schema_validation", "elapsed_seconds"],
      "additionalProperties": false
    }
  }
}
